<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd" >

    <bean id="identityimport.batchDAO" class="fr.paris.lutece.plugins.identityimport.business.BatchDAO" />
    <bean id="identityimport.candidateIdentityDAO" class="fr.paris.lutece.plugins.identityimport.business.CandidateIdentityDAO" />
    <bean id="identityimport.candidateIdentityHistoryDao" class="fr.paris.lutece.plugins.identityimport.business.CandidateIdentityHistoryDAO" />
    <bean id="identityimport.candidateIdentityAttributeDAO" class="fr.paris.lutece.plugins.identityimport.business.CandidateIdentityAttributeDAO" />
    <bean id="identityimport.clientDAO" class="fr.paris.lutece.plugins.identityimport.business.ClientDAO" />


	<bean id="identityimport.batch.wfbeanservice" class="fr.paris.lutece.plugins.identityimport.wf.WorkflowBeanService">
		<constructor-arg index="0" value="IDENTITYIMPORT_BATCH_RESOURCE" />
    	<constructor-arg index="1" type="int" value="1"/>
	</bean>
	
	<bean id="identityimport.candidateidentity.wfbeanservice" class="fr.paris.lutece.plugins.identityimport.wf.WorkflowBeanService">
		<constructor-arg index="0" value="IDENTITYIMPORT_CANDIDATE_RESOURCE" />
    	<constructor-arg index="1" type="int" value="2"/>
	</bean>

	<!-- IHttpTransportProvider declarations -->
	<bean id="identityimport.httpAccessTransport-ids" class="fr.paris.lutece.plugins.identitystore.v3.web.rs.service.HttpAccessTransport" >
		<property name="apiEndPointUrl">
			<value>${identityimport.identitystore.api.endpoint.url}</value>
		</property>
	</bean>
	<bean id="identityimport.restTransport.identity.httpAccess" class="fr.paris.lutece.plugins.identitystore.v3.web.rs.service.IdentityTransportRest">
		<constructor-arg ref="identityimport.httpAccessTransport-ids" />
	</bean>
	<bean id="identityimport.restTransport.serviceContract.httpAccess" class="fr.paris.lutece.plugins.identitystore.v3.web.rs.service.ServiceContractTransportRest">
		<constructor-arg ref="identityimport.httpAccessTransport-ids"/>
	</bean>
	<bean id="identityimport.restTransport.referential.httpAccess" class="fr.paris.lutece.plugins.identitystore.v3.web.rs.service.ReferentialTransportRest">
		<constructor-arg ref="identityimport.httpAccessTransport-ids" />
	</bean>

	<!-- IdentityService impl -->
	<bean id="identityimport.identityService.rest" class="fr.paris.lutece.plugins.identitystore.v3.web.service.IdentityService">
		<constructor-arg ref="identityimport.restTransport.identity.httpAccess"/>
	</bean>

	<!-- ServiceContractService impl -->
	<bean id="identityimport.identity.serviceContractService" class="fr.paris.lutece.plugins.identitystore.v3.web.service.ServiceContractService">
		<constructor-arg ref="identityimport.restTransport.serviceContract.httpAccess"/>
	</bean>

	<!-- ReferentialService  impl -->
	<bean id="identityimport.identity.referentialService" class="fr.paris.lutece.plugins.identitystore.v3.web.service.ReferentialService">
		<constructor-arg ref="identityimport.restTransport.referential.httpAccess"/>
	</bean>

	<!-- IHttpTransportProvider declarations -->
	<bean id="identityimport.httpAccessTransport-quality" class="fr.paris.lutece.plugins.identityquality.v3.web.rs.service.HttpAccessTransport" >
		<property name="apiEndPointUrl">
			<value>${identityimport.identitystore.api.endpoint.url}</value>
		</property>
	</bean>
	<bean id="identityimport.restTransport.quality.httpAccess" class="fr.paris.lutece.plugins.identityquality.v3.web.rs.service.IdentityQualityTransportRest">
		<constructor-arg ref="identityimport.httpAccessTransport-quality" />
	</bean>

	<!-- IdentityService impl -->
	<bean id="identityimport.qualityService.rest" class="fr.paris.lutece.plugins.identityquality.v3.web.service.IdentityQualityService">
		<constructor-arg ref="identityimport.restTransport.quality.httpAccess"/>
	</bean>

	<!-- Cache -->
	<bean id="identityimport.identity.serviceContractCacheService"  class="fr.paris.lutece.plugins.identityimport.cache.ServiceContractCache">
		<constructor-arg ref="identityimport.identity.serviceContractService"/>
	</bean>
	<bean id="identityimport.identity.serviceReferentialCache"  class="fr.paris.lutece.plugins.identityimport.cache.ReferentialCache">
		<constructor-arg ref="identityimport.identity.referentialService"/>
	</bean>

	<!-- REST -->
	<bean id="identityimport.customObjectMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.CustomMapper" />
	<bean id="identityimport.uncaughtExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtExceptionMapper" />
	<bean id="identityimport.uncaughtIdentityStoreExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtIdentityStoreExceptionMapper" />
	<bean id="identityimport.uncaughtClientAuthorizationExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtClientAuthorizationExceptionMapper" />
	<bean id="identityimport.uncaughtDuplicatesConsistencyExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtDuplicatesConsistencyExceptionMapper" />
	<bean id="identityimport.uncaughtRequestContentFormattingExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtRequestContentFormattingExceptionMapper" />
	<bean id="identityimport.uncaughtRequestFormatExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtRequestFormatExceptionMapper" />
	<bean id="identityimport.uncaughtResourceNotFoundExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtResourceNotFoundExceptionMapper" />
	<bean id="identityimport.uncaughtJerseyExceptionMapper"  class="fr.paris.lutece.plugins.identityimport.web.rs.error.UncaughtJerseyExceptionMapper" />

	<bean id="identityimport.batchRestService"  class="fr.paris.lutece.plugins.identityimport.web.rs.BatchRestService" />
</beans>
